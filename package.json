{
  "name": "@livtorgex/strategy-workflow",
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Shared workflow graph view for LivTorgEx apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6"
  },
  "peerDependencies": {
    "@livtorgex/ui-kit": ">=0.1.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@livtorgex/ui-kit": "github:LivTorgEx/ui-kit#main",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
